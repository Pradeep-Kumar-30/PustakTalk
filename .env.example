# Application
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
AUTH_SECRET=change-this-with-a-long-random-value
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data services
# Keep these three values aligned with DATABASE_URL before the first Compose start.
POSTGRES_DB=pustaktalk
POSTGRES_USER=pustaktalk
POSTGRES_PASSWORD=pustaktalk
DATABASE_URL=postgresql+psycopg://pustaktalk:pustaktalk@postgres:5432/pustaktalk
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pustaktalk_chunks
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=pustaktalk
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=pustaktalk-documents
MINIO_SECURE=false

# Local AI. Do not set cloud API keys here; local Ollama needs no key.
# Set true before `make up` only after the core stack works. It installs the
# larger local embedding, speech-to-text, and text-to-speech Python packages.
INSTALL_AI=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:0.6b
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_HINDI_VOICE=hi_IN-pratham-medium
# The Compose stack persists the voices at this path. Download licence-approved
# Piper voices there before enabling production text-to-speech.
PIPER_DATA_DIR=/models/piper

# Security and limits
MAX_UPLOAD_BYTES=52428800
RATE_LIMIT_PER_MINUTE=60
CHUNK_SIZE_TOKENS=420
CHUNK_OVERLAP_TOKENS=60
